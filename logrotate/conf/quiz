/var/log/hotseller/quiz-api/*.log /var/log/hotseller/quiz-api/**/*.log {
    su ubuntu ubuntu
    create 664 ubuntu ubuntu
    daily
    rotate 30
    dateext
    dateformat -%Y-%m-%d
    maxage 30
    missingok
    compress
    notifempty
    sharedscripts
    postrotate
		    /bin/bash /home/ubuntu/src/quiz-api/reload.sh;
		    /bin/bash /home/ubuntu/src/quiz-api/run_scheduler.sh;
    endscript
}