/var/log/jypark/quiz-api/*.log /var/log/jypark/quiz-api/**/*.log {
    su root root                # 권한 문제 방지 (ubuntu → root)
    create 644 jypark jypark   # 로그 소유자에 맞게 수정
    daily
    rotate 30
    dateext
    dateformat -%Y-%m-%d
    maxage 30
    missingok
    compress
    notifempty
    sharedscripts
    postrotate
        /bin/bash /home/jypark/ai-repository/scripts/reload.sh || true
    endscript
}