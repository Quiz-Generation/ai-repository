/var/log/jypark/quiz-api/*.log /var/log/jypark/quiz-api/**/*.log {
    su jypark jypark
    create 644 jypark jypark
    daily
    rotate 30
    dateext
    dateformat -%Y-%m-%d
    maxage 30
    missingok
    compress
    notifempty
    sharedscripts
    postrotate
        /bin/bash /home/jypark/ai-repository/scripts/reload.sh
    endscript
}